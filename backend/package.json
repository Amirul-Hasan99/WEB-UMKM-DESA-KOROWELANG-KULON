{
  "name": "umkm-korowelang-kulon-backend",
  "version": "1.0.0",
  "description": "RESTful API Backend for UMKM Desa Korowelang Kulon Portal",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/db/seed.js",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "express",
    "umkm",
    "korowelang-kulon",
    "rest-api",
    "jwt",
    "neon",
    "drizzle"
  ],
  "author": "Kelurahan Korowelang Kulon",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.3",
    "argon2": "^0.40.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.22.7",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
