# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Contoh: mongodb+srv://username:password@cluster0.xxxx.mongodb.net/umkm_kutoharjo?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxx.mongodb.net/umkm_kutoharjo?retryWrites=true&w=majority

# JWT Secret Key (WAJIB! Generate via node: console.log(require('crypto').randomBytes(64).toString('hex')))
JWT_SECRET=your-strong-jwt-secret-key-here

# Cloudinary Storage Credentials (Opsional — untuk upload gambar)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Production Frontend Allowed Domain for CORS
FRONTEND_URL=https://umkm-desa-kutoharjo.vercel.app
