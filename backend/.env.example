# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://umkm-kutoharjo:umkm-kutoharjo@cluster0.cjyj96b.mongodb.net/umkm_kutoharjo?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret Key (WAJIB! Generate via node: console.log(require('crypto').randomBytes(64).toString('hex')))
