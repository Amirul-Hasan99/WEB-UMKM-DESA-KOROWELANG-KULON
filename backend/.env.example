# ================================================================
# BACKEND ENVIRONMENT VARIABLES — UMKM Desa Kutoharjo
# ================================================================
# Copy file ini ke ".env" dan isi dengan nilai yang sesuai.
# JANGAN COMMIT file .env ke git!
# ================================================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# ================================================================
# DATABASE (WAJIB di production!)
# ================================================================
# Format Supabase (Transaction Pooler):
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Format Neon:
# postgresql://[user]:[password]@[host].neon.tech/[database]?sslmode=require
#
DATABASE_URL=postgresql://postgres.uvsygywlnyaofdeowpsq:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ================================================================
# JWT SECRET (WAJIB! Minimal 32 karakter, random & kuat)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ================================================================
JWT_SECRET=your-very-strong-random-jwt-secret-key-minimum-32-chars

# JWT Token expiry (default: 1d = 1 hari)
JWT_EXPIRES_IN=1d

# ================================================================
# CLOUDINARY (Untuk upload foto UMKM & Produk)
# Daftar gratis di: https://cloudinary.com/
# ================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================================================================
# CORS — Allowed Frontend Domain
# ================================================================
# Development: http://localhost:3000
# Production: URL frontend Vercel Anda
FRONTEND_URL=https://umkm-desa-kutoharjo.vercel.app
