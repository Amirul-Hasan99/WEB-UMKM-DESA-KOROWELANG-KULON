# ================================================================
# FRONTEND ENVIRONMENT VARIABLES — UMKM Desa Korowelang Kulon
# ================================================================
# Copy file ini ke ".env.local" dan isi dengan nilai yang sesuai.
# JANGAN COMMIT file .env.local ke git!
# ================================================================

# ================================================================
# BACKEND API URL
# Development: http://localhost:5000
# Production: URL backend Anda di Vercel/Railway/Render
# ================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ================================================================
# NEXTAUTH (jika masih digunakan untuk SSO/OAuth)
# Untuk login admin custom (localStorage + cookie), ini optional.
# ================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-korowelang-kulon-umkm-hub-2026

# ================================================================
# CATATAN PRODUCTION:
# - Set NEXT_PUBLIC_BACKEND_URL ke URL backend production di Vercel.
# - Set NEXTAUTH_URL ke URL frontend production di Vercel.
# - Kedua nilai ini WAJIB diisi di Vercel Environment Variables.
# ================================================================
